{
  "name": "trae2opencode",
  "version": "1.0.0",
  "description": "Migrate recoverable TRAE sessions to OpenCode",
  "bin": {
    "trae2opencode": "./dist/cli/index.js"
  },
  "files": [
    "dist/**/*.js",
    "!dist/**/__tests__/**",
    "docs/**/*.md",
    "fixtures/opencode/2.0.12/evidence/transfer.schema.json",
    "fixtures/ir/v1/valid-trae-assembled.json"
  ],
  "engines": {
    "node": ">=18.18.0"
  },
  "directories": {
    "doc": "docs"
  },
  "type": "module",
  "scripts": {
    "lint": "biome lint --error-on-warnings src scripts",
    "test": "node scripts/run-tests.mjs",
    "schema:ir": "tsx scripts/write-ir-schema.ts",
    "golden:update": "tsx scripts/update-golden-fixtures.ts",
    "golden:check": "node --import tsx --test src/ir/__tests__/golden.test.ts",
    "collect-fixtures": "npx tsx scripts/collect-fixtures.ts",
    "collect:trae-runtime-evidence": "tsx scripts/collect-trae-runtime-evidence.ts",
    "collect:trae-structured-runtime-evidence": "tsx scripts/collect-trae-structured-runtime-evidence.ts",
    "verify:opencode": "tsx scripts/verify-opencode-roundtrip.ts",
    "verify:platform": "tsx scripts/verify-platform.ts",
    "verify:versions": "tsx scripts/verify-version-contract.ts",
    "verify:resilience": "node --max-old-space-size=512 --import tsx scripts/verify-resilience.ts",
    "verify:package": "tsx scripts/verify-package.ts",
    "verify:live": "tsx scripts/verify-live-runtime.ts",
    "migrate:local": "npm run build && zsh scripts/migrate-local.zsh",
    "prepack": "node scripts/prepare-package.mjs",
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.integration.json",
    "smoke": "node dist/cli/index.js --version",
    "check": "npm run lint && npm test && npm run typecheck && npm run build && npm run smoke"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.2",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "better-sqlite3": "^11.10.0",
    "jsonc-parser": "^3.3.1",
    "ws": "^8.21.3"
  }
}
